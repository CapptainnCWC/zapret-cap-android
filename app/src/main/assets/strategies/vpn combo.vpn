# vpn combo
# Сгенерировано tools/bat2vpn.py. Каждая строка - группа ciadpi. Своя идея ByeDPI, в Windows-версии аналога нет.

-j %LISTS%/vpn-ipset-exclude.txt
-K u -V 443 -a 6 -t 64 -l %FAKE%/quic_initial_www_google_com.bin
-K u -V 19294-19344 -a 6 -t 64 -l %FAKE%/ACTIVE_DISCORD_UDP.bin
-K u -V 50000-50100 -a 6 -t 64 -l %FAKE%/ACTIVE_DISCORD_UDP.bin
-K t,h -H %LISTS%/vpn-list-exclude.txt
-K t,h -H %LISTS%/vpn-list-google.txt -f -1 -l %FAKE%/tls_clienthello_www_google_com.bin -t 6 --fake-hold 350
-K t,h -H %LISTS%/vpn-list-general.txt -f -1 -t 5 --fake-hold 350
