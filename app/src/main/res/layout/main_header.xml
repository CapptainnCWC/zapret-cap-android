<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- настройки фоновой работы: видна, только если что-то мешает -->
    <LinearLayout
        android:id="@+id/bg_card"
        style="@style/Card"
        android:layout_marginBottom="10dp"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            style="@style/SectionTitle"
            android:text="@string/bg_card_title"
            android:textColor="@color/danger" />

        <TextView
            android:id="@+id/bg_text"
            style="@style/Muted"
            android:layout_marginTop="2dp" />

        <LinearLayout
            android:id="@+id/bg_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <!-- тестовая сборка: журнал пушей -->
    <LinearLayout
        style="@style/Card"
        android:layout_marginBottom="10dp"
        android:padding="12dp">

        <TextView
            style="@style/SectionTitle"
            android:text="@string/push_log_title" />

        <TextView
            android:id="@+id/push_log_info"
            style="@style/Muted"
            android:layout_marginTop="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/push_log_access"
                style="@style/TonalButton"
                android:layout_width="0dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="@string/push_log_access" />

            <TextView
                android:id="@+id/push_log_send"
                style="@style/TonalButton"
                android:layout_width="0dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="@string/push_log_send" />

            <TextView
                android:id="@+id/push_log_clear"
                style="@style/TonalButton"
                android:layout_width="0dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="@string/push_log_clear" />
        </LinearLayout>

        <TextView
            android:id="@+id/push_log_mark"
            style="@style/TonalButton"
            android:layout_width="match_parent"
            android:layout_marginTop="8dp"
            android:text="@string/push_log_mark" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/hero"
        style="@style/Card"
        android:background="@drawable/bg_card"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/hero_icon"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_circle"
                android:contentDescription="@null"
                android:padding="12dp"
                android:src="@drawable/ic_shield" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/on_surface"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/status_detail"
                    style="@style/Muted"
                    android:layout_marginTop="2dp"
                    android:maxLines="2"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_error"
            android:padding="10dp"
            android:textColor="@color/danger"
            android:textIsSelectable="true"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/toggle"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button_primary"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textSize="17sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/test_configs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tile"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_tune" />

            <TextView
                style="@style/SectionTitle"
                android:layout_marginStart="10dp"
                android:text="@string/test_button"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/open_domains"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tile"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_list" />

            <TextView
                style="@style/SectionTitle"
                android:layout_marginStart="10dp"
                android:text="@string/domains_button"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        style="@style/Card"
        android:layout_marginTop="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView style="@style/SectionTitle" android:text="@string/tg_title" />

                <TextView
                    android:id="@+id/tg_status"
                    style="@style/Muted"
                    android:layout_marginTop="2dp"
                    android:textSize="12sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/tg_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/tg_title" />
        </LinearLayout>

        <TextView
            android:id="@+id/tg_strategy_pick"
            style="@style/TonalButton"
            android:layout_width="match_parent"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical|start"
            android:drawableEnd="@android:drawable/arrow_down_float"
            android:drawableTint="@color/muted" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tg_connect"
                style="@style/TonalButton"
                android:layout_width="0dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="3"
                android:text="@string/tg_connect" />

            <TextView
                android:id="@+id/tg_open_settings"
                style="@style/TonalButton"
                android:layout_width="0dp"
                android:layout_marginStart="4dp"
                android:layout_weight="2"
                android:text="@string/tg_settings" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        style="@style/SectionTitle"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:text="@string/configs_title" />

    <LinearLayout
        android:id="@+id/net_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_segments"
        android:orientation="horizontal"
        android:padding="3dp">

        <TextView android:id="@+id/tab_wifi" style="@style/Segment" />
        <TextView android:id="@+id/tab_cell" style="@style/Segment" />
    </LinearLayout>

    <TextView
        android:id="@+id/hint"
        style="@style/Muted"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:textSize="12sp" />
</LinearLayout>
