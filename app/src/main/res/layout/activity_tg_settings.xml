<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tg_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tg_settings_title"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView style="@style/SettingsSection" android:text="@string/tg_section_connection" />

        <TextView style="@style/SettingsLabel" android:text="@string/tg_port" />
        <EditText
            android:id="@+id/tg_port"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />

        <TextView style="@style/SettingsLabel" android:text="@string/tg_secret" />
        <EditText
            android:id="@+id/tg_secret"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text|textNoSuggestions"
            android:typeface="monospace" />

        <TextView style="@style/SettingsSection" android:text="@string/tg_section_dc" />
        <TextView style="@style/SettingsHint" android:text="@string/tg_dc_hint" />
        <EditText
            android:id="@+id/tg_dc_ips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:inputType="textMultiLine|textNoSuggestions"
            android:minLines="2" />

        <TextView style="@style/SettingsSection" android:text="@string/tg_section_cf" />
        <CheckBox
            android:id="@+id/tg_cfproxy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tg_cfproxy" />
        <CheckBox
            android:id="@+id/tg_h2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tg_h2" />
        <TextView style="@style/SettingsLabel" android:text="@string/tg_cf_domains" />
        <EditText
            android:id="@+id/tg_cf_domains"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri" />
        <TextView style="@style/SettingsLabel" android:text="@string/tg_worker_domains" />
        <EditText
            android:id="@+id/tg_worker_domains"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri" />
        <CheckBox
            android:id="@+id/tg_no_secure"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tg_no_secure" />

        <TextView style="@style/SettingsSection" android:text="@string/tg_section_strategy" />
        <TextView style="@style/SettingsHint" android:text="@string/tg_strategy_hint" />
        <Spinner
            android:id="@+id/tg_strategy"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <TextView style="@style/SettingsSection" android:text="@string/tg_section_performance" />
        <TextView style="@style/SettingsLabel" android:text="@string/tg_buf_kb" />
        <EditText
            android:id="@+id/tg_buf_kb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />
        <TextView style="@style/SettingsLabel" android:text="@string/tg_pool" />
        <EditText
            android:id="@+id/tg_pool"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />

        <Button
            android:id="@+id/tg_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/tg_save" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/tg_test"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tg_test" />
            <Button
                android:id="@+id/tg_copy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tg_copy_link" />
            <Button
                android:id="@+id/tg_log"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tg_log" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
